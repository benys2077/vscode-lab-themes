    "statusBarItem.remoteBackground": "#dc7a6c",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBar.debuggingBackground": "#b04638",
    "editorGroupHeader.tabsBackground": "#fae7e3",
    "editorGroup.border": "#f0b8b0",
    "tab.activeBorderTop": "#b04638",
    "tab.inactiveBackground": "#fae7e3",
    "tab.activeBackground": "#fbf5f3",
    "tab.activeForeground": "#1f1f1f",
    "tab.border": "#f0b8b0",
    "breadcrumb.background": "#fbf5f3",
    "breadcrumb.foreground": "#4a4a4a",
    "breadcrumb.focusForeground": "#b04638",
    "breadcrumb.activeSelectionForeground": "#b04638",
    "panel.background": "#fae7e3",
    "panel.border": "#f0b8b0",
    "panelTitle.activeBorder": "#b04638",
    "panelTitle.activeForeground": "#b04638",
    "list.activeSelectionBackground": "#f3cdc7",
    "list.activeSelectionForeground": "#1f1f1f",
    "list.inactiveSelectionBackground": "#fae7e3",
    "list.hoverBackground": "#f3cdc780",
    "list.highlightForeground": "#b04638",
    "button.background": "#dc7a6c",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#b04638",
    "badge.background": "#1f7f86",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#dc7a6c",
    "textLink.foreground": "#b04638",
    "textLink.activeForeground": "#dc7a6c",
    "editor.background": "#fbf5f3",
    "editorGutter.background": "#fbf5f3",
    "minimap.background": "#fbf5f3",
    "editorPane.background": "#fbf5f3",
    "editor.lineHighlightBackground": "#f7e5e1",
    "editor.lineHighlightBorder": "#f7e5e1",
    "editor.selectionBackground": "#f3cdc7",
    "editor.inactiveSelectionBackground": "#fae7e3",
    "editor.selectionHighlightBackground": "#fae7e3",
    "editor.wordHighlightBackground": "#fae7e3",
    "editor.wordHighlightStrongBackground": "#f3cdc7",
    "editor.findMatchBackground": "#c6e6e8",
    "editor.findMatchHighlightBackground": "#c6e6e899",
    "editorBracketMatch.background": "#f3cdc7",
    "editorBracketMatch.border": "#dc7a6c",
    "editorCursor.foreground": "#b04638",
    "editorLineNumber.foreground": "#9a9a9a",
    "editorLineNumber.activeForeground": "#b04638",
    "editorIndentGuide.background1": "#fae7e3",
    "editorIndentGuide.activeBackground1": "#f0b8b0",
    "editorWhitespace.foreground": "#fae7e3",
    "editorRuler.foreground": "#fae7e3",
    "editorCodeLens.foreground": "#1f7f86",
    "editorLink.activeForeground": "#b04638",
    "editorOverviewRuler.border": "#f0b8b0",
    "editorHoverWidget.background": "#fae7e3",
    "editorHoverWidget.border": "#f0b8b0",
    "editorSuggestWidget.background": "#fbf5f3",
    "editorSuggestWidget.border": "#f0b8b0",
    "editorSuggestWidget.selectedBackground": "#f3cdc7",
    "scrollbarSlider.background": "#fae7e3",
    "scrollbarSlider.hoverBackground": "#f3cdc7",
    "scrollbarSlider.activeBackground": "#f0b8b0",
    "minimap.selectionHighlight": "#f3cdc7",
    "minimapSlider.background": "#fae7e380",
    "editorWidget.background": "#fae7e3",
    "editorWidget.border": "#f0b8b0",
    "input.background": "#ffffff",
    "input.border": "#f0b8b0",
    "inputOption.activeBorder": "#b04638",
    "dropdown.border": "#f0b8b0",
    "editorGutter.modifiedBackground": "#dc7a6c",
    "editorGutter.addedBackground": "#dc7a6c",
    "gitDecoration.modifiedResourceForeground": "#b04638",
    "sash.hoverBorder": "#dc7a6c",
    "terminal.background": "#fbf5f3",
    "terminal.selectionBackground": "#f3cdc7",
    "terminalCursor.foreground": "#b04638",
    "peekView.border": "#dc7a6c",
    "peekViewEditor.background": "#fae7e3",
    "notificationCenterHeader.background": "#f0b8b0",
    "notifications.background": "#fae7e3",
    "pickerGroup.foreground": "#b04638",
    "quickInput.background": "#fbf5f3",
    "quickInputList.focusBackground": "#f3cdc7",
    "menu.background": "#fbf5f3",
    "menu.selectionBackground": "#f3cdc7",
    "menu.selectionForeground": "#1f1f1f"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#b04638"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#1f7f86"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#b04638",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#1f7f86"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#dc7a6c"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2b2b2b"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#b04638"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1f7f86"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8a82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#b04638",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
