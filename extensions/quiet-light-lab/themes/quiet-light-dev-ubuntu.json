{
  "name": "Quiet Light dev-ubuntu",
  "type": "light",
  "include": "./quiet-light-base.json",
  "colors": {
    "focusBorder": "#8aa64a",
    "titleBar.activeBackground": "#c9d9a6",
    "titleBar.activeForeground": "#1f1f1f",
    "titleBar.inactiveBackground": "#eef3e1",
    "titleBar.inactiveForeground": "#1f1f1f99",
    "activityBar.background": "#c9d9a6",
    "activityBar.foreground": "#1f1f1f",
    "activityBar.inactiveForeground": "#1f1f1f88",
    "activityBar.activeBorder": "#587228",
    "activityBarBadge.background": "#7a4d9e",
    "activityBarBadge.foreground": "#ffffff",
    "statusBar.background": "#c9d9a6",
    "statusBar.foreground": "#1f1f1f",
    "statusBarItem.hoverBackground": "#8aa64a",
    "statusBarItem.remoteBackground": "#8aa64a",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBar.debuggingBackground": "#587228",
    "editorGroupHeader.tabsBackground": "#eef3e1",
    "editorGroup.border": "#c9d9a6",
    "tab.activeBorderTop": "#587228",
    "tab.inactiveBackground": "#eef3e1",
    "tab.activeBackground": "#f6f8f0",
    "tab.activeForeground": "#1f1f1f",
    "tab.border": "#c9d9a6",
    "breadcrumb.background": "#f6f8f0",
    "breadcrumb.foreground": "#4a4a4a",
    "breadcrumb.focusForeground": "#587228",
    "breadcrumb.activeSelectionForeground": "#587228",
    "panel.background": "#eef3e1",
    "panel.border": "#c9d9a6",
    "panelTitle.activeBorder": "#587228",
    "panelTitle.activeForeground": "#587228",
    "list.activeSelectionBackground": "#dde8c2",
    "list.activeSelectionForeground": "#1f1f1f",
    "list.inactiveSelectionBackground": "#eef3e1",
    "list.hoverBackground": "#dde8c280",
    "list.highlightForeground": "#587228",
    "button.background": "#8aa64a",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#587228",
    "badge.background": "#7a4d9e",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#8aa64a",
    "textLink.foreground": "#587228",
    "textLink.activeForeground": "#8aa64a",
    "editor.background": "#f6f8f0",
    "editorGutter.background": "#f6f8f0",
    "minimap.background": "#f6f8f0",
    "editorPane.background": "#f6f8f0",
    "editor.lineHighlightBackground": "#e9efd9",
    "editor.lineHighlightBorder": "#e9efd9",
    "editor.selectionBackground": "#dde8c2",
    "editor.inactiveSelectionBackground": "#eef3e1",
    "editor.selectionHighlightBackground": "#eef3e1",
    "editor.wordHighlightBackground": "#eef3e1",
    "editor.wordHighlightStrongBackground": "#dde8c2",
    "editor.findMatchBackground": "#e4d5f1",
    "editor.findMatchHighlightBackground": "#e4d5f199",
    "editorBracketMatch.background": "#dde8c2",
    "editorBracketMatch.border": "#8aa64a",
    "editorCursor.foreground": "#587228",
    "editorLineNumber.foreground": "#9a9a9a",
    "editorLineNumber.activeForeground": "#587228",
    "editorIndentGuide.background1": "#eef3e1",
    "editorIndentGuide.activeBackground1": "#c9d9a6",
    "editorWhitespace.foreground": "#eef3e1",
    "editorRuler.foreground": "#eef3e1",
    "editorCodeLens.foreground": "#7a4d9e",
    "editorLink.activeForeground": "#587228",
    "editorOverviewRuler.border": "#c9d9a6",
    "editorHoverWidget.background": "#eef3e1",
    "editorHoverWidget.border": "#c9d9a6",
    "editorSuggestWidget.background": "#f6f8f0",
    "editorSuggestWidget.border": "#c9d9a6",
    "editorSuggestWidget.selectedBackground": "#dde8c2",
    "scrollbarSlider.background": "#eef3e1",
    "scrollbarSlider.hoverBackground": "#dde8c2",
    "scrollbarSlider.activeBackground": "#c9d9a6",
    "minimap.selectionHighlight": "#dde8c2",
    "minimapSlider.background": "#eef3e180",
    "editorWidget.background": "#eef3e1",
    "editorWidget.border": "#c9d9a6",
    "input.background": "#ffffff",
    "input.border": "#c9d9a6",
    "inputOption.activeBorder": "#587228",
    "dropdown.border": "#c9d9a6",
    "editorGutter.modifiedBackground": "#8aa64a",
    "editorGutter.addedBackground": "#8aa64a",
    "gitDecoration.modifiedResourceForeground": "#587228",
    "sash.hoverBorder": "#8aa64a",
    "terminal.background": "#f6f8f0",
    "terminal.selectionBackground": "#dde8c2",
    "terminalCursor.foreground": "#587228",
    "peekView.border": "#8aa64a",
    "peekViewEditor.background": "#eef3e1",
    "notificationCenterHeader.background": "#c9d9a6",
    "notifications.background": "#eef3e1",
    "pickerGroup.foreground": "#587228",
    "quickInput.background": "#f6f8f0",
    "quickInputList.focusBackground": "#dde8c2",
    "menu.background": "#f6f8f0",
    "menu.selectionBackground": "#dde8c2",
    "menu.selectionForeground": "#1f1f1f"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#587228"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#7a4d9e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#587228",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#7a4d9e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#8aa64a"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2b2b2b"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#587228"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7a4d9e"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8a82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#587228",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
