    "editorPane.background": "#171b12",
    "editor.lineHighlightBackground": "#212818",
    "editor.lineHighlightBorder": "#212818",
    "editor.selectionBackground": "#3b4a25",
    "editor.inactiveSelectionBackground": "#1c2314",
    "editor.selectionHighlightBackground": "#1c2314",
    "editor.wordHighlightBackground": "#1c2314",
    "editor.wordHighlightStrongBackground": "#3b4a25",
    "editor.findMatchBackground": "#3a2a4c",
    "editor.findMatchHighlightBackground": "#3a2a4c99",
    "editorBracketMatch.background": "#3b4a25",
    "editorBracketMatch.border": "#8aa64a",
    "editorCursor.foreground": "#c3d68a",
    "editorLineNumber.foreground": "#5f6b78",
    "editorLineNumber.activeForeground": "#c3d68a",
    "editorIndentGuide.background1": "#1c2314",
    "editorIndentGuide.activeBackground1": "#2c3a1c",
    "editorWhitespace.foreground": "#3b4a25",
    "editorRuler.foreground": "#1c2314",
    "editorCodeLens.foreground": "#b48be0",
    "editorLink.activeForeground": "#c3d68a",
    "editorOverviewRuler.border": "#2c3a1c",
    "editorHoverWidget.background": "#1c2314",
    "editorHoverWidget.border": "#2c3a1c",
    "editorSuggestWidget.background": "#171b12",
    "editorSuggestWidget.border": "#2c3a1c",
    "editorSuggestWidget.selectedBackground": "#3b4a25",
    "scrollbarSlider.background": "#1c2314",
    "scrollbarSlider.hoverBackground": "#3b4a25",
    "scrollbarSlider.activeBackground": "#2c3a1c",
    "minimap.selectionHighlight": "#3b4a25",
    "minimapSlider.background": "#1c231480",
    "editorWidget.background": "#1c2314",
    "editorWidget.border": "#2c3a1c",
    "input.background": "#1c2314",
    "input.border": "#2c3a1c",
    "inputOption.activeBorder": "#c3d68a",
    "dropdown.border": "#2c3a1c",
    "editorGutter.modifiedBackground": "#8aa64a",
    "editorGutter.addedBackground": "#8aa64a",
    "gitDecoration.modifiedResourceForeground": "#c3d68a",
    "sash.hoverBorder": "#8aa64a",
    "terminal.background": "#171b12",
    "terminal.selectionBackground": "#3b4a25",
    "terminalCursor.foreground": "#c3d68a",
    "peekView.border": "#8aa64a",
    "peekViewEditor.background": "#1c2314",
    "notificationCenterHeader.background": "#2c3a1c",
    "notifications.background": "#1c2314",
    "pickerGroup.foreground": "#c3d68a",
    "quickInput.background": "#171b12",
    "quickInputList.focusBackground": "#3b4a25",
    "menu.background": "#171b12",
    "menu.selectionBackground": "#3b4a25",
    "menu.selectionForeground": "#e6e6e6"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#c3d68a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#b48be0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c3d68a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#b48be0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#8aa64a"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#c3d68a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b48be0"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d8590",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#c3d68a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
