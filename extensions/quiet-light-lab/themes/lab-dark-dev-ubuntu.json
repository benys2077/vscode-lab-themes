    "tab.activeForeground": "#e6e6e6",
    "tab.border": "#2c3a1c",
    "breadcrumb.background": "#171b12",
    "breadcrumb.foreground": "#4a4a4a",
    "breadcrumb.focusForeground": "#c3d68a",
    "breadcrumb.activeSelectionForeground": "#c3d68a",
    "panel.background": "#1c2314",
    "panel.border": "#2c3a1c",
