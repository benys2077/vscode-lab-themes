    "list.hoverBackground": "#3b4a2580",
    "list.highlightForeground": "#c3d68a",
    "button.background": "#8aa64a",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#c3d68a",
    "badge.background": "#b48be0",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#8aa64a",
    "textLink.foreground": "#c3d68a",
