    "tab.inactiveBackground": "#e3edf9",
    "tab.activeBackground": "#f4f7fb",
    "tab.activeForeground": "#1f1f1f",
    "tab.border": "#a8c8ec",
    "breadcrumb.background": "#f4f7fb",
    "breadcrumb.foreground": "#4a4a4a",
    "breadcrumb.focusForeground": "#2f5fa8",
    "breadcrumb.activeSelectionForeground": "#2f5fa8",
    "panel.background": "#e3edf9",
    "panel.border": "#a8c8ec",
    "panelTitle.activeBorder": "#2f5fa8",
    "panelTitle.activeForeground": "#2f5fa8",
    "list.activeSelectionBackground": "#c9dcf3",
    "list.activeSelectionForeground": "#1f1f1f",
    "list.inactiveSelectionBackground": "#e3edf9",
    "list.hoverBackground": "#c9dcf380",
    "list.highlightForeground": "#2f5fa8",
    "button.background": "#5b8fd6",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#2f5fa8",
    "badge.background": "#b5701f",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#5b8fd6",
    "textLink.foreground": "#2f5fa8",
    "textLink.activeForeground": "#5b8fd6",
    "editor.background": "#f4f7fb",
    "editorGutter.background": "#f4f7fb",
    "minimap.background": "#f4f7fb",
    "editorPane.background": "#f4f7fb",
    "editor.lineHighlightBackground": "#e6eef8",
    "editor.lineHighlightBorder": "#e6eef8",
    "editor.selectionBackground": "#c9dcf3",
    "editor.inactiveSelectionBackground": "#e3edf9",
    "editor.selectionHighlightBackground": "#e3edf9",
    "editor.wordHighlightBackground": "#e3edf9",
    "editor.wordHighlightStrongBackground": "#c9dcf3",
    "editor.findMatchBackground": "#f3dfc0",
    "editor.findMatchHighlightBackground": "#f3dfc099",
    "editorBracketMatch.background": "#c9dcf3",
    "editorBracketMatch.border": "#5b8fd6",
    "editorCursor.foreground": "#2f5fa8",
    "editorLineNumber.foreground": "#9a9a9a",
    "editorLineNumber.activeForeground": "#2f5fa8",
    "editorIndentGuide.background1": "#e3edf9",
    "editorIndentGuide.activeBackground1": "#a8c8ec",
    "editorWhitespace.foreground": "#e3edf9",
    "editorRuler.foreground": "#e3edf9",
    "editorCodeLens.foreground": "#b5701f",
    "editorLink.activeForeground": "#2f5fa8",
    "editorOverviewRuler.border": "#a8c8ec",
    "editorHoverWidget.background": "#e3edf9",
    "editorHoverWidget.border": "#a8c8ec",
    "editorSuggestWidget.background": "#f4f7fb",
    "editorSuggestWidget.border": "#a8c8ec",
    "editorSuggestWidget.selectedBackground": "#c9dcf3",
    "scrollbarSlider.background": "#e3edf9",
    "scrollbarSlider.hoverBackground": "#c9dcf3",
    "scrollbarSlider.activeBackground": "#a8c8ec",
    "minimap.selectionHighlight": "#c9dcf3",
    "minimapSlider.background": "#e3edf980",
    "editorWidget.background": "#e3edf9",
    "editorWidget.border": "#a8c8ec",
    "input.background": "#ffffff",
    "input.border": "#a8c8ec",
    "inputOption.activeBorder": "#2f5fa8",
    "dropdown.border": "#a8c8ec",
    "editorGutter.modifiedBackground": "#5b8fd6",
    "editorGutter.addedBackground": "#5b8fd6",
    "gitDecoration.modifiedResourceForeground": "#2f5fa8",
    "sash.hoverBorder": "#5b8fd6",
    "terminal.background": "#f4f7fb",
    "terminal.selectionBackground": "#c9dcf3",
    "terminalCursor.foreground": "#2f5fa8",
    "peekView.border": "#5b8fd6",
    "peekViewEditor.background": "#e3edf9",
    "notificationCenterHeader.background": "#a8c8ec",
    "notifications.background": "#e3edf9",
    "pickerGroup.foreground": "#2f5fa8",
    "quickInput.background": "#f4f7fb",
    "quickInputList.focusBackground": "#c9dcf3",
    "menu.background": "#f4f7fb",
    "menu.selectionBackground": "#c9dcf3",
    "menu.selectionForeground": "#1f1f1f"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#2f5fa8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#b5701f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2f5fa8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#b5701f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#5b8fd6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2b2b2b"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#2f5fa8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b5701f"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8a82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#2f5fa8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
